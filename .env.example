# Telegram: create a bot with @BotFather, paste the token, then send /start to your bot to get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional free LLM for cover letters & tailored summaries. Leave LLM_PROVIDER empty to disable.
#   gemini  -> free key at https://aistudio.google.com/apikey
#   groq    -> free key at https://console.groq.com/keys
#   ollama  -> runs locally, no key (https://ollama.com)
#   openrouter -> use a ":free" model
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

PORT=3000
# Path to Chrome/Chromium used to render PDFs
CHROME_PATH=/usr/bin/google-chrome
